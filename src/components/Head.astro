---
import { site } from '@/data/site';
import { personJsonLd } from '@/lib/seo';

interface Props {
  title: string;
  description?: string;
  /** Path (e.g. /essays/foo/) used for the canonical and Open Graph address */
  path?: string;
  type?: 'website' | 'article' | 'profile';
  image?: string;
  imageAlt?: string;
  published?: Date;
  updated?: Date;
  tags?: string[];
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
  isHome?: boolean;
  /** Extra name/content meta tags (Google Scholar's citation_* tags, for instance). */
  meta?: { name: string; content: string }[];
}

const {
  title,
  description = site.description,
  path = Astro.url.pathname,
  type = 'website',
  image = '/og/default.png',
  imageAlt = `${site.name} — Philosopher & Researcher`,
  published,
  updated,
  tags = [],
  jsonLd = [],
  noindex = false,
  isHome = false,
  meta = [],
} = Astro.props;

// pages are served from directories, so the address that answers without a redirect ends in a slash
const cleanPath = /\.[a-z0-9]+$/i.test(path) || path.endsWith('/') ? path : `${path}/`;
const canonical = new URL(cleanPath, site.url).toString();
// search results show about 60 characters of a title and 155 of a description: keep the name when it fits, trim at a word when it does not
const fullTitle = isHome ? site.title : `${title} — ${site.name}`.length <= 66 ? `${title} — ${site.name}` : title;
const desc = description.length > 160 ? `${description.slice(0, 156).replace(/[\s,;:]+\S*$/, '')}…` : description;
const ogImage = new URL(image, site.url).toString();
const ld = [personJsonLd(), ...jsonLd];
---

<title>{fullTitle}</title>
<meta name="description" content={desc} />
<meta name="author" content={site.name} />
<meta name="keywords" content={site.keywords.join(', ')} />
{!noindex && <link rel="canonical" href={canonical} />}
{noindex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}
<meta name="theme-color" content="#0d0d10" />
<meta name="color-scheme" content="dark light" />

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={`${site.name} — Essays`} href="/rss.xml" />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={site.locale} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={desc} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
{type === 'article' && published && <meta property="article:published_time" content={published.toISOString()} />}
{type === 'article' && updated && <meta property="article:modified_time" content={updated.toISOString()} />}
{type === 'article' && <meta property="article:author" content={site.name} />}
{type === 'article' && tags.map((t) => <meta property="article:tag" content={t} />)}
{type === 'profile' && <meta property="profile:first_name" content="Abhinav" />}
{type === 'profile' && <meta property="profile:last_name" content="Saxena" />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={desc} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={imageAlt} />
{site.twitterHandle && <meta name="twitter:site" content={`@${site.twitterHandle}`} />}
{site.twitterHandle && <meta name="twitter:creator" content={`@${site.twitterHandle}`} />}

{meta.map((m) => <meta name={m.name} content={m.content} />)}
{site.verification.google && <meta name="google-site-verification" content={site.verification.google} />}
{site.verification.bing && <meta name="msvalidate.01" content={site.verification.bing} />}

{ld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
