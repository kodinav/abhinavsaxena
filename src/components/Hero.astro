---
import { getCollection } from 'astro:content';

/**
 * Hero concepts: four primary (inline in the axis line) and five floating in
 * the field. Anchors feed the WebGL field; positions of floating labels are
 * fractions of the hero box.
 */
const concepts = await getCollection('concepts');
const byId = new Map(concepts.map((c) => [c.id, c]));
const primary = ['ai', 'mind', 'ethics', 'technology'];
const floating: { id: string; x: number; y: number }[] = [
  { id: 'knowledge', x: 0.7, y: 0.22 },
  { id: 'agency', x: 0.86, y: 0.38 },
  { id: 'consciousness', x: 0.62, y: 0.52 },
  { id: 'responsibility', x: 0.9, y: 0.66 },
  { id: 'trust', x: 0.7, y: 0.84 },
];
const ids = [...primary, ...floating.map((f) => f.id)];
const nodes = ids.map((id) => {
  const c = byId.get(id)!;
  return { id, label: c.data.title === 'Artificial Intelligence' ? 'AI' : c.data.title, primary: primary.includes(id), definition: c.data.definition };
});
const links: { a: string; b: string; note: string }[] = [];
const seen = new Set<string>();
for (const id of ids) {
  for (const r of byId.get(id)!.data.relations) {
    if (!ids.includes(r.to.id)) continue;
    const key = [id, r.to.id].sort().join('|');
    if (seen.has(key)) continue;
    seen.add(key);
    links.push({ a: id, b: r.to.id, note: r.note });
  }
}
const graph = JSON.stringify({ nodes, links });
const nameWords = 'ABHINAV SAXENA'.split(' ');
const defaultBridge = 'Move through the field. Each concept is a live question — hover one to see what it touches, open it to follow the thread.';
---
<section class="hero" data-hero data-graph={graph} aria-labelledby="hero-name">
  <div class="hero__labels" data-field-labels>
    {nodes.filter((n) => !n.primary).map((n) => {
      const f = floating.find((x) => x.id === n.id)!;
      return (
        <a class="hero__float" href={`/ideas#${n.id}`} data-concept={n.id} data-hero-in style={`--fx:${f.x * 100}%;--fy:${f.y * 100}%`}>
          <i class="hero__anchor" data-anchor aria-hidden="true"></i><span>{n.label}</span>
        </a>
      );
    })}
  </div>

  <div class="hero__inner container">
    <p class="hero__eyebrow eyebrow" data-hero-in>Philosopher · Researcher · Writer</p>
    <h1 class="hero__name" id="hero-name" aria-label="Abhinav Saxena" data-kinetic>
      {nameWords.map((word) => (
        <span class="hero__wordwrap" aria-hidden="true">
          {word.split('').map((ch) => <span class="hero__letter" data-letter><span data-hero-letter>{ch}</span></span>)}
        </span>
      ))}
    </h1>
    <p class="hero__axis serif" data-hero-in>
      <span class="hero__word hero__word--static">Philosophy</span>
      {nodes.filter((n) => n.primary).map((n) => (
        <>
          <span class="hero__x" aria-hidden="true">×</span>
          <a class="hero__word" href={`/ideas#${n.id}`} data-concept={n.id}>{n.label}<i class="hero__anchor hero__anchor--sup" data-anchor aria-hidden="true"></i></a>
        </>
      ))}
    </p>
    <p class="hero__bridge" data-bridge data-default={defaultBridge} aria-live="polite" data-hero-in>{defaultBridge}</p>
    <div class="hero__cta" data-hero-in>
      <a class="btn btn--solid" href="/research" data-magnetic="0.2">Explore the research</a>
      <a class="arrow-link" href="/essays">Read the essays <span class="arr" aria-hidden="true"></span></a>
    </div>
  </div>

  <a class="hero__scroll" href="#intro" aria-label="Scroll to introduction" data-hero-in>
    <span class="hero__scroll-line" aria-hidden="true"></span>
    <span class="eyebrow">Scroll</span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: calc(100svh - var(--nav-h));
    display: grid;
    align-items: start;
    isolation: isolate;
  }
  .hero__inner { position: relative; z-index: 2; padding-block: clamp(3rem, 11vh, 7.5rem) var(--s-3xl); }
  .hero__eyebrow { margin-bottom: var(--s-m); }
  .hero__name {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: var(--step-7);
    line-height: 0.95;
    letter-spacing: 0.035em;
    text-transform: uppercase;
    display: flex; flex-wrap: wrap; column-gap: 0.28em;
    max-width: 14ch;
    color: var(--ink);
    font-optical-sizing: none;
    font-variation-settings: 'wght' 400, 'opsz' 72;
  }
  .hero__wordwrap { display: inline-flex; white-space: nowrap; }
  .hero__letter { display: inline-block; overflow: hidden; padding-bottom: 0.04em; margin-bottom: -0.04em; }
  .hero__letter > span { display: inline-block; will-change: transform; }
  html.js:not(.is-ready) .hero__letter > span { visibility: hidden; }
  html.js:not(.is-ready) [data-hero-in] { opacity: 0; }

  .hero__axis { margin-top: var(--s-l); font-size: var(--step-2); line-height: 1.3; display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.35em 0.5em; max-width: 30ch; }
  .hero__x { color: var(--ink-3); font-size: 0.7em; }
  .hero__word { position: relative; display: inline-block; color: var(--ink); transition: color var(--dur-2); }
  .hero__word:not(.hero__word--static)::after { content: ''; position: absolute; left: 0; right: 0; bottom: -0.06em; height: 1px; background: var(--accent); transform: scaleX(0); transform-origin: left; transition: transform var(--dur-3) var(--ease-out); }
  .hero__word.is-active { color: var(--accent); }
  .hero__word.is-active::after { transform: scaleX(1); }
  .hero__word.is-related::after { transform: scaleX(1); opacity: 0.35; }
  .hero.has-active .hero__word:not(.is-active):not(.is-related):not(.hero__word--static) { color: var(--ink-3); }
  .hero__word--static { font-style: italic; color: var(--ink-2); }
  .hero__anchor { display: inline-block; width: 5px; height: 5px; border-radius: 50%; background: currentColor; transition: transform var(--dur-2) var(--ease-spring), background-color var(--dur-2), opacity var(--dur-2); }
  .hero__anchor--sup { width: 4px; height: 4px; vertical-align: super; margin-left: 0.12em; opacity: 0.55; }
  .hero__word.is-active .hero__anchor, .hero__float.is-active .hero__anchor { transform: scale(1.8); opacity: 1; }
  .hero__word.is-related .hero__anchor, .hero__float.is-related .hero__anchor { opacity: 1; background: var(--accent); }

  .hero__bridge { margin-top: var(--s-m); max-width: 44ch; min-height: 7.2em; font-family: var(--font-sans); font-size: var(--step--1); line-height: 1.55; color: var(--ink-2); text-wrap: pretty; }
  .hero__bridge :global(.hero__bridge-def) { display: block; color: var(--ink); font-family: var(--font-serif); font-size: var(--step-0); font-style: italic; }
  .hero__bridge :global(.hero__bridge-rel) { display: block; margin-top: 0.45em; }
  .hero__bridge :global(.hero__bridge-pair) { color: var(--accent); font-weight: 500; letter-spacing: 0.02em; margin-right: 0.35em; }
  .hero__cta { margin-top: var(--s-l); display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-m); }

  .hero__labels { position: absolute; inset: 0; z-index: 1; pointer-events: none; }
  .hero__float {
    position: absolute; left: var(--fx); top: var(--fy); transform: translate(-50%, -50%);
    pointer-events: auto; display: inline-flex; align-items: center; gap: 0.6em;
    font-family: var(--font-sans); font-size: var(--step--1); font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--ink-2); padding: 0.5em 0.8em; transition: color var(--dur-2);
  }
  .hero__float:hover, .hero__float.is-active { color: var(--accent); }
  .hero__float.is-related { color: var(--ink); }
  .hero.has-active .hero__float:not(.is-active):not(.is-related) { color: var(--ink-3); }

  .hero__scroll { position: absolute; right: var(--gutter); bottom: var(--s-l); z-index: 2; display: flex; align-items: center; gap: 0.75rem; color: var(--ink-3); }
  .hero__scroll-line { width: 3rem; height: 1px; background: var(--line-2); position: relative; overflow: hidden; }
  .hero__scroll-line::after { content: ''; position: absolute; inset: 0; background: var(--ink); transform-origin: left; animation: scroll-hint 2.2s var(--ease-in-out) infinite; }
  @keyframes scroll-hint { 0% { transform: scaleX(0); transform-origin: left } 50% { transform: scaleX(1); transform-origin: left } 51% { transform-origin: right } 100% { transform: scaleX(0); transform-origin: right } }

  @media (max-width: 900px) {
    .hero__labels { position: static; display: flex; flex-wrap: wrap; gap: 0.25rem 0.5rem; order: 3; padding: 0 var(--gutter) var(--s-l); z-index: 2; }
    .hero { grid-template-rows: 1fr auto; }
    .hero__float { position: static; transform: none; padding: 0.4em 0.6em 0.4em 0; }
    .hero__scroll { display: none; }
    .hero__inner { padding-bottom: var(--s-m); }
    .hero__name { max-width: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    html.js:not(.is-ready) .hero__letter > span { visibility: visible; }
    html.js:not(.is-ready) [data-hero-in] { opacity: 1; }
    .hero__scroll-line::after { animation: none; transform: scaleX(0.5); }
  }
</style>
