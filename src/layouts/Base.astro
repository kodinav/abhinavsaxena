---
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import Head from '@/components/Head.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import '@/styles/tokens.css';
import '@/styles/base.css';
import '@/styles/motion.css';
import '@/styles/prose.css';
import '@/styles/cursor.css';
import '@/styles/print.css';

interface Props {
  title: string;
  description?: string;
  path?: string;
  type?: 'website' | 'article' | 'profile';
  image?: string;
  imageAlt?: string;
  published?: Date;
  updated?: Date;
  tags?: string[];
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
  isHome?: boolean;
  bodyClass?: string;
  /** How the WebGL field behaves on this page. */
  field?: 'hero' | 'ambient' | 'reading' | 'off';
}
const { bodyClass = '', field = 'ambient', ...head } = Astro.props;
const preWords = ['Philosophy', 'AI', 'Mind', 'Ethics', 'Technology'];
const preName = 'Abhinav Saxena'.split('');
---
<!doctype html>
<html lang="en" class="no-js" id="top">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline data-astro-rerun>
      (function () {
        var t = null;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        document.documentElement.setAttribute('data-theme', t === 'light' ? 'light' : 'dark');
        document.documentElement.classList.remove('no-js');
        document.documentElement.classList.add('js');
      })();
    </script>
    <Font cssVariable="--font-serif" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-sans" preload={[{ style: 'normal' }]} />
    <Head {...head} />
    <ClientRouter />
  </head>
  <body class={bodyClass} data-field-mode={field}>
    <div class="preloader" data-preloader transition:persist="preloader" aria-hidden="true">
      <div class="preloader__inner">
        <span class="preloader__count tnum" data-pre-count>0</span>
        <div class="preloader__words">
          {preWords.map((w) => <span class="preloader__word serif" data-pre-word>{w}</span>)}
        </div>
        <div class="preloader__name serif" data-pre-name>
          {preName.map((ch) => ch === ' ' ? <span class="preloader__space"> </span> : <span>{ch}</span>)}
        </div>
        <span class="preloader__line" data-pre-line></span>
      </div>
    </div>
    <div class="curtain" data-curtain transition:persist="curtain" aria-hidden="true">
      <span class="curtain__label serif" data-curtain-label></span>
    </div>
    <canvas class="field" data-field transition:persist="field" aria-hidden="true"></canvas>
    <div class="grain" data-grain transition:persist="grain" aria-hidden="true"></div>

    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <main id="main" class="site-main">
      <slot />
    </main>
    <Footer />
    <script>
      import '@/scripts/main';
    </script>
  </body>
</html>
<style is:global>
  .site-main { position: relative; z-index: 1; padding-top: var(--nav-h); min-height: 70dvh; }
</style>
