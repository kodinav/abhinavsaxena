---
import Base from '@/layouts/Base.astro';
import PublicationEntry from '@/components/PublicationEntry.astro';
import { site } from '@/data/site';
import { cv } from '@/data/cv';
import { getResearch, getPublications, getQuestions, pubHref } from '@/lib/content';
import { breadcrumbJsonLd } from '@/lib/seo';

const [areas, pubs, questions] = await Promise.all([getResearch(), getPublications(), getQuestions()]);
const areaTitles = Object.fromEntries(areas.map((a) => [a.id, a.data.title]));
const featuredPubs = [...pubs.filter((p) => p.data.featured), ...pubs.filter((p) => !p.data.featured)].slice(0, 3);
const education = cv.sections.find((s) => s.id === 'education')?.entries ?? [];
const talks = cv.sections.find((s) => s.id === 'talks')?.entries ?? [];
const forthcoming = pubs.filter((p) => p.data.status === 'forthcoming');
const inReview = pubs.filter((p) => p.data.status === 'under-review');
const profileLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: { '@id': `${site.url}/#person` },
  url: `${site.url}/about`,
  name: 'About Abhinav Saxena',
};
---
<Base title="About" description="Abhinav Saxena is a philosopher working in epistemology — testimony and the social epistemology of AI — and on the ethics and politics of algorithmic systems. Background, research, current work and profiles." path="/about/" type="profile" jsonLd={[profileLd, breadcrumbJsonLd([{ name: 'Home', path: '/' }, { name: 'About', path: '/about/' }])]}>
  <article class="about">
    <header class="section about__head">
      <div class="container grid">
        <div class="about__side"><span class="eyebrow" data-reveal>About</span></div>
        <div class="about__main">
          <h1 class="h1" data-split="chars">Abhinav Saxena</h1>
          <p class="about__role" data-reveal>Philosopher · Researcher · Writer</p>
          <p class="about__lead serif" data-split="lines" data-split-delay="0.2">
            I work on what happens to our oldest concepts — knowledge, testimony, consent, responsibility — when they meet machines that seem to know, answer and decide.
          </p>
        </div>
      </div>
    </header>

    <section class="section about__section" aria-labelledby="who">
      <div class="container grid">
        <div class="about__side"><h2 class="tag" id="who" data-reveal>Who I am</h2></div>
        <div class="about__main prose" data-reveal>
          <p>I am a philosopher and independent researcher based in New Delhi. My area of specialisation is epistemology, with a focus on testimony and the social epistemology of artificial intelligence; my areas of competence are philosophy of technology, political philosophy, ethics and environmental ethics. I studied philosophy at Mahatma Jyotiba Phule Rohilkhand University and the University of Delhi.</p>
          <p>Two lines of work run through what I write. The first asks what it takes for a source to transmit knowledge, and argues that large language models, on the best current evidence, do not: the truth of what they say does not figure, through their own operation, in why they say it. The second asks what institutions owe the people their algorithmic systems govern, and argues that where a system produces a person's standing rather than merely acting on it, consent cannot be what legitimates it.</p>
          <p>I work in the analytic tradition, with wider interests in philosophy of mind and in classical Indian philosophy, phenomenology and existentialism. I write for philosophers, and also for the engineers, policymakers and readers who have to live with these questions before philosophy has finished with them.</p>
        </div>
      </div>
    </section>

    <section class="section about__section" aria-labelledby="background">
      <div class="container grid">
        <div class="about__side"><h2 class="tag" id="background" data-reveal>Academic background</h2></div>
        <div class="about__main">
          <dl class="about__timeline" data-reveal-group="60">
            {education.map((e) => (
              <div class="about__entry" data-reveal>
                <dt>{e.period}</dt>
                <dd>
                  <span class="serif about__entry-title">{e.title}</span>
                  {e.org && <span class="about__entry-org">{e.org}{e.place ? `, ${e.place}` : ''}</span>}
                  {e.detail && <span class="about__entry-detail">{e.detail}</span>}
                </dd>
              </div>
            ))}
          </dl>
          <a class="arrow-link" href="/cv/" style="margin-top: var(--s-m); display: inline-flex">Full curriculum vitae <span class="arr" aria-hidden="true"></span></a>
        </div>
      </div>
    </section>

    <section class="section about__section" aria-labelledby="interests">
      <div class="container grid">
        <div class="about__side"><h2 class="tag" id="interests" data-reveal>Research interests</h2></div>
        <div class="about__main">
          <ul class="about__areas" role="list" data-reveal-group="50">
            {areas.map((a) => <li data-reveal><a class="about__area" href={`/research/${a.id}/`}><span class="serif">{a.data.title}</span><span class="about__area-short">{a.data.short}</span></a></li>)}
          </ul>
        </div>
      </div>
    </section>

    <section class="section about__section" aria-labelledby="current">
      <div class="container grid">
        <div class="about__side"><h2 class="tag" id="current" data-reveal>Current work</h2></div>
        <div class="about__main">
          <p class="lede" data-split="lines" data-split-delay="0.15">Two questions organise my current writing:</p>
          <ol class="about__qs" role="list" data-reveal-group="60">
            {questions.slice(0, 2).map((q) => <li class="serif" data-reveal>{q.data.question}</li>)}
          </ol>
          <div class="about__now prose" data-reveal>
            <p>{forthcoming.map((p) => <><a class="link" href={pubHref(p)}>{p.data.title.split(':')[0]}</a> is forthcoming in <em>{p.data.venue}</em>. </>)}{inReview.length > 0 && <>Under review: {inReview.map((p, i) => <>{i > 0 && (i === inReview.length - 1 ? ' and ' : ', ')}<a class="link" href={pubHref(p)}>{p.data.title.split(':')[0]}</a> (<em>{p.data.venue}</em>{p.data.note && `, ${p.data.note.toLowerCase()}`})</>)}.</>}</p>
            <p>Recent talks: {talks.map((t, i) => <>{i > 0 && '; '}<em>{t.title.split(':')[0]}</em> ({t.org}, {t.period})</>)}.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section about__section" aria-labelledby="selected">
      <div class="container grid">
        <div class="about__side"><h2 class="tag" id="selected" data-reveal>Selected publications</h2></div>
        <div class="about__main">
          <div class="about__pubs">{featuredPubs.map((p) => <PublicationEntry pub={p} index={pubs.length - pubs.indexOf(p)} areaTitles={areaTitles} compact />)}</div>
          <a class="arrow-link" href="/publications/" style="margin-top: var(--s-m); display: inline-flex">All publications <span class="arr" aria-hidden="true"></span></a>
        </div>
      </div>
    </section>

    <section class="section about__section" aria-labelledby="profiles">
      <div class="container grid">
        <div class="about__side"><h2 class="tag" id="profiles" data-reveal>Profiles</h2></div>
        <div class="about__main">
          <ul class="about__profiles" role="list" data-reveal>
            {site.profiles.map((p) => <li><a class="link" href={p.url} rel="me noopener" target="_blank">{p.label}</a>{p.handle && <span class="muted"> {p.handle}</span>}</li>)}
          </ul>
          <p data-reveal style="margin-top: var(--s-m)">Correspondence: <a class="link" href={`mailto:${site.email}`}>{site.email}</a></p>
        </div>
      </div>
    </section>
  </article>
</Base>
<style>
  .about__side { grid-column: 1 / span 3; }
  .about__main { grid-column: 4 / span 8; }
  .about__role { margin-top: var(--s-xs); font-family: var(--font-sans); font-size: var(--step--1); letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-3); }
  .about__lead { margin-top: var(--s-l); font-size: var(--step-3); line-height: 1.2; letter-spacing: -0.012em; max-width: 26ch; text-wrap: balance; }
  .about__section { padding-block: var(--s-xl); }
  .about__timeline { display: flex; flex-direction: column; border-top: 1px solid var(--line); }
  .about__entry { display: grid; grid-template-columns: 9rem 1fr; gap: var(--s-m); padding: var(--s-s) 0; border-bottom: 1px solid var(--line); }
  .about__entry dt { font-family: var(--font-sans); font-size: var(--step--1); color: var(--ink-3); }
  .about__entry dd { margin: 0; display: flex; flex-direction: column; gap: 0.2rem; }
  .about__entry-title { font-size: var(--step-1); }
  .about__entry-org { font-family: var(--font-sans); font-size: var(--step--1); color: var(--ink-2); }
  .about__entry-detail { font-family: var(--font-sans); font-size: var(--step--1); color: var(--ink-3); }
  .about__areas { display: grid; grid-template-columns: 1fr 1fr; gap: 0; border-top: 1px solid var(--line); }
  .about__area { display: flex; flex-direction: column; gap: 0.2rem; padding: var(--s-s) var(--s-s) var(--s-s) 0; border-bottom: 1px solid var(--line); font-size: var(--step-1); transition: color var(--dur-1); }
  .about__area-short { font-family: var(--font-sans); font-size: var(--step--1); color: var(--ink-3); }
  .about__area:hover { color: var(--accent); }
  .about__qs { margin-top: var(--s-m); display: flex; flex-direction: column; gap: var(--s-s); font-size: var(--step-2); line-height: 1.2; counter-reset: q; }
  .about__qs li { position: relative; padding-left: 2.5rem; text-wrap: balance; }
  .about__qs li::before { counter-increment: q; content: counter(q, decimal-leading-zero); position: absolute; left: 0; top: 0.35em; font-family: var(--font-sans); font-size: var(--step--2); letter-spacing: 0.1em; color: var(--ink-3); }
  .about__pubs { border-bottom: 1px solid var(--line); }
  .about__profiles { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5rem 1rem; font-size: var(--step--1); }
  .about__now { margin-top: var(--s-m); color: var(--ink-2); }
  @media (max-width: 900px) {
    .about__side, .about__main { grid-column: 1 / -1; }
    .about__main { margin-top: var(--s-s); }
    .about__areas { grid-template-columns: 1fr; }
    .about__profiles { grid-template-columns: 1fr 1fr; }
    .about__entry { grid-template-columns: 1fr; gap: 0.25rem; }
  }
</style>
